{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Release (Ninja + MSVC portable)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "cl.exe",
        "CMAKE_CXX_COMPILER": "cl.exe",
        "CMAKE_RC_COMPILER": "rc.exe"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug (Ninja + MSVC portable)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "cl.exe",
        "CMAKE_CXX_COMPILER": "cl.exe",
        "CMAKE_RC_COMPILER": "rc.exe"
      }
    },
    {
      "name": "ci",
      "displayName": "Release (Visual Studio, per i runner di GitHub)",
      "description": "Non usa la toolchain portable di tools\\: CMake trova da solo Visual Studio, che sui runner windows-latest e' gia' installato. Serve solo alla CI.",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/ci",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Release"
      }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "release" },
    { "name": "debug", "configurePreset": "debug" },
    { "name": "ci", "configurePreset": "ci", "configuration": "Release" }
  ]
}
