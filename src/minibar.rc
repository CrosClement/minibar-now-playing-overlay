#include <windows.h>
#include "resource.h"

IDI_MINIBAR ICON "..\\assets\\minibar.ico"

// RT_MANIFEST = 24
1 24 "minibar.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "MiniBar - mini player overlay"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "minibar"
            VALUE "OriginalFilename", "minibar.exe"
            VALUE "ProductName", "MiniBar"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
